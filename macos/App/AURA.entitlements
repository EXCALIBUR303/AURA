<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: the app reads only its own bundle and container. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections: the loopback Vite dev server (development) and,
	     from Phase 3B/4, GitHub and AI provider APIs. No incoming connections. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Microphone for voice input (Phase 3C). macOS still asks the user first. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
