# Copy to .env.local (gitignored). Never put tokens or API keys in env files:
# GitHub tokens and LLM API keys are stored in the macOS Keychain by the app.

# Frontend (read by Vite; only VITE_* are exposed to the page)
# auto = native bridge inside AURA.app, mock in a normal browser
VITE_AURA_BRIDGE=auto

# Native shell (read by AuraApp at launch; development only)
# Must be http://localhost or http://127.0.0.1
AURA_DEV_SERVER_URL=http://127.0.0.1:5173
# Alternative to the dev server: serve a production build from disk
# AURA_WEB_ROOT=/absolute/path/to/frontend/dist
# Override where aura.sqlite lives (default ~/Library/Application Support/AURA)
# AURA_DATA_DIR=/tmp/aura-dev
# GitHub App client ID for `swift run` (public identifier, not a secret; AURA.app
# reads it from Info.plist). There is no client secret: sign-in uses the device flow.
# AURA_GITHUB_CLIENT_ID=Iv23liQPMjrFatEpesLu
