{
  "name": "aura-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "node --test ../shared/test/*.test.ts",
    "inspect:avatar": "node ../tools/inspect-glb.mjs ../assets/avatar/community/astra-lumen/astra_lumen_ii_a_rigged_companion_android.glb",
    "test:browser": "node test/studio.browser.mjs",
    "audit:performance": "node test/performance.browser.mjs",
    "test:github": "node test/github.browser.mjs",
    "test:astra": "node test/astra.browser.mjs",
    "test:world": "node test/world.test.ts",
    "test:world:browser": "node test/world.browser.mjs",
    "test:voice": "node test/voice-controller.test.ts",
    "test:voice:browser": "node test/voice.browser.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "motion": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
